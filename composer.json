{
    "name": "develate/grok-cli-php",
    "description": "A PHP SDK for controlling Grok Build via ACP and headless CLI.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "Develate\\GrokCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Develate\\GrokCli\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Thorsten",
            "email": "thorsten@develate.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/process": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
